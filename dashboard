<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Analítico - mulheres na computação</title>
    <!-- Importando Chart.js para os gráficos -->
    <script src="https://jsdelivr.net"></script>
    <style>
        /* Reset de Estilos Básicos */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f6f9;
            color: #333;
            display: flex;
            min-height: 100vh;
        }

        /* Barra Lateral (Sidebar) */
        .sidebar {
            width: 250px;
            background-color: #1e293b;
            color: #fff;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        .sidebar h2 {
            font-size: 20px;
            margin-bottom: 30px;
            text-align: center;
            color: #38bdf8;
        }

        .sidebar a {
            color: #cbd5e1;
            text-decoration: none;
            padding: 12px 15px;
            margin-bottom: 10px;
            border-radius: 6px;
            transition: 0.3s;
        }

        .sidebar a:hover, .sidebar a.active {
            background-color: #334155;
            color: #fff;
        }

        /* Conteúdo Principal */
        .main-content {
            flex: 1;
            padding: 30px;
            overflow-y: auto;
        }

        header {
            margin-bottom: 30px;
        }

        header h1 {
            font-size: 26px;
            color: #0f172a;
        }

        /* Cartões de Métrica (Cards) */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            border-left: 5px solid #3b82f6;
        }

        .card.success { border-left-color: #10b981; }
        .card.warning { border-left-color: #f59e0b; }

        .card h3 {
            font-size: 14px;
            color: #64748b;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .card .value {
            font-size: 24px;
            font-weight: bold;
            color: #1e293b;
        }

        /* Grade de Gráficos */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 25px;
        }

        .chart-container {
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            position: relative;
            height: 320px;
        }

        .chart-container h3 {
            margin-bottom: 15px;
            font-size: 16px;
            color: #334155;
        }

        /* Design responsivo para telas menores */
        @media (max-width: 768px) {
            body { flex-direction: column; }
            .sidebar { width: 100%; height: auto; }
            .charts-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <!-- BARRA LATERAL -->
    <nav class="sidebar">
        <h2>Guia de Gerenciamento</h2>
        <a href="#" class="active">Visão Geral</a>
        <a href="#">Atuação por setores</a>
        <a href="#">Interesse por áreas</a>
        <a href="#">Configurações</a>
    </nav>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="main-content">
        <header>
            <h1>Visão Geral da participação de Mulheres na Computação</h1>
        </header>

        <!-- CARTÕES DE MÉTRICA -->
        <section class="cards-grid">
            <div class="card">
                <h3>Porcentagem de participação - ingressos (mulheres)</h3>
                <div class="value">38%</div>
            </div>
            <div class="card success">
                <h3>Comparativo - Ano anterior</h3>
                <div class="value">+ 20%</div>
            </div>
            <div class="card warning">
                <h3>Taxa de Concluintes (F/M)</h3>
                <div class="value">78%/60%</div>
            </div>
        </section>

        <!-- GRÁFICOS -->
        <section class="charts-grid">
            <div class="chart-container">
                <h3>Ingresso por semestre (Linha)</h3>
                <canvas id="salesChart"></canvas>
            </div>
            <div class="chart-container">
                <h3>Disribuição por faixa etária (Barra)</h3>
                <canvas id="productsChart"></canvas>
            </div>
        </section>
    </main>

    <!-- JAVASCRIPT: Lógica e Gráficos -->
    <script>
        // 1. Configuração do Gráfico de Vendas (Linha)
        const ctxSales = document.getElementById('salesChart').getContext('2d');
        const salesChart = new Chart(ctxSales, {
            type: 'line',
            data: {
                labels: ['1º sem/2025','2º sem/2025', '1º sem/2026', '2º sem/2026', '1º sem/2027 projetado', '2º sem/2027 projetado'],
                datasets: [{
                    label: 'Ingressos nº absoluto',
                    data: [22, 12, 30, 14, 32, 15],
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4 // Deixa a linha suave/curvada
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                }
            }
        });

        // 2. Configuração do Gráfico de Concluintes (Barra)
        const ctxProducts = document.getElementById('productsChart').getContext('2d');
        const productsChart = new Chart(ctxProducts, {
            type: 'bar',
            data: {
                labels: ['1º sem/2025','2º sem/2025', '1º sem/2026', '2º sem/2026', '1º sem/2027 projetado', '2º sem/2027 projetado'],
                datasets: [{
                    label: 'Concluintes',
                    data: [18, 9, 15, 5, 19, 8],
                    backgroundColor: ['#10b981', '#3b82f6', '#f59e0b', '#ef4444'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                }
            }
        });
    </script>
</body>
</html>
